<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- High Purity Suspendium -->
    <ThingDef ParentName="ResourceBase">
        <defName>ToR_HighSuspendium</defName>
        <label>pure suspendium</label>
        <description>A rare and valuable resource used in advanced technologies. It possesses many unknown properties that make it highly sought after.</description>
        <graphicData>
            <texPath>Things/Item/Suspendium High</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>ChunkRock_Drop</soundInteract>
        <soundDrop>ChunkRock_Drop</soundDrop>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>15</MarketValue>
            <RoyalFavorValue>0.02</RoyalFavorValue>
            <Mass>0.001</Mass>
            <StuffPower_Armor_Sharp>1.30</StuffPower_Armor_Sharp>
            <StuffPower_Armor_Blunt>0.70</StuffPower_Armor_Blunt>
            <StuffPower_Armor_Heat>0.85</StuffPower_Armor_Heat>
            <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>3</StuffPower_Insulation_Heat>
            <SharpDamageMultiplier>1.2</SharpDamageMultiplier>
            <BluntDamageMultiplier>1.2</BluntDamageMultiplier>
        </statBases>
        <thingCategories>
            <li>ResourcesRaw</li>
        </thingCategories>
        <stackLimit>500</stackLimit>
        <smallVolume>true</smallVolume>
        <deepCommonality>0.1</deepCommonality>
        <deepCountPerPortion>5</deepCountPerPortion>
        <deepLumpSizeRange>1~8</deepLumpSizeRange>
        <burnableByRecipe>false</burnableByRecipe>
        <smeltable>false</smeltable>
        <possessionCount>10</possessionCount>
        <stuffProps>
            <stuffAdjective>shinsu</stuffAdjective>
            <categories>
                <li>Stony</li>
            </categories>
            <appearance>Metal</appearance>
            <commonality>0.01</commonality>
            <isAirtight>true</isAirtight>
            <color>(8,235,235)</color>
            <constructEffect>ConstructMetal</constructEffect>
            <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
            <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
            <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
            <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
            <statOffsets>
                <Beauty>15</Beauty>
            </statOffsets>
            <statFactors>
                <MaxHitPoints>3</MaxHitPoints>
                <Flammability>0</Flammability>
                <Beauty>3</Beauty>
                <WorkToMake>3</WorkToMake>
                <WorkToBuild>3</WorkToBuild>
                <MeleeWeapon_CooldownMultiplier>0.7</MeleeWeapon_CooldownMultiplier>
            </statFactors>
        </stuffProps>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <allowedArchonexusCount>50</allowedArchonexusCount>
        <tradeTags>
            <li>ExoticMisc</li>
            <li>TowerOfGod</li>
        </tradeTags>
        <thingSetMakerTags>
            <li>RewardStandardCore</li>
        </thingSetMakerTags>
    </ThingDef>
