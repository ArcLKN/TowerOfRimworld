<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="RockBase">
        <defName>MineableHighSuspendium</defName>
        <label>pure suspendium ore</label>
        <description>Rock containing bits of pure suspendium.</description>
        <graphicData>
            <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <color>(95, 161, 161)</color>
            <colorTwo>(8,155,255)</colorTwo>
        </graphicData>
        <statBases>
            <MaxHitPoints>5000</MaxHitPoints>
        </statBases>
        <building>
            <isResourceRock>true</isResourceRock>
            <mineableThing>ToR_HighSuspendium</mineableThing>
            <mineableYield>5</mineableYield>
            <mineableScatterCommonality>0.01</mineableScatterCommonality>
            <mineableScatterLumpSizeRange>1~6</mineableScatterLumpSizeRange>
            <veinMineable>true</veinMineable>
        </building>
    </ThingDef>
